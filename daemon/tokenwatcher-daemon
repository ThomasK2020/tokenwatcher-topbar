def load_config():
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                cfg = json.load(f)
                res = DEFAULT_CONFIG.copy()
                res.update(cfg)
                return res
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()


def clean_model_name(raw_name):
    if not raw_name:
        return "Standby"
    lower = str(raw_name).lower()
    if lower.startswith("gemini"):
        # Dynamic Title Case for Gemini models
        # Preserve version numbers like 3.7, 3.8 as single tokens
        import re
        parts = re.split(r'([.-])', raw_name)
        cleaned_parts = []
        for part in parts:
            if part in [".", "-"]:
                cleaned_parts.append(part)
            elif part.replace(".", "").isdigit():
                cleaned_parts.append(part)
            else:
                cleaned_parts.append(part.capitalize())
        result = "".join(cleaned_parts).replace(" ", "")
        # Replace hyphens with spaces for final output
        return result.replace("-", " ")
    if "qwen3-coder-30b" in lower or "qwen3-coder" in lower:
        return "Qwen3-Coder-30B"
    if "gemma-4-12b" in lower or "gemma 4 12b" in lower:
        return "Gemma-4-12B"
    if "gemma-4-31b" in lower or "gemma 4 31b" in lower:
        return "Gemma-4-31B"
    if "claude-3-7-sonnet" in lower:
        return "Claude 3.7 Sonnet"
    if "claude-3-5-sonnet" in lower:
        return "Claude 3.5 Sonnet"
    if "gpt-4o" in lower:
        return "GPT-4o"
    name = str(raw_name).strip()
    if "/" in name:
        name = name.split("/")[-1]
    name = name.replace(".gguf", "").replace(".GGUF", "")
    for ext in [":latest", "-it-GGUF", "-Instruct-GGUF", "-it", "-Instruct", "-A3B"]:
        if name.endswith(ext):
            name = name[:-len(ext)]
    return name


def get_lemonade_loaded_model(base_url="http://127.0.0.1:13305"):
    try:
        req = urllib.request.Request(f"{base_url}/api/v1/health", headers={"Accept-Encoding": "gzip"})
        with urllib.request.urlopen(req, timeout=1.0) as resp:
            data = resp.read()
            if resp.info().get("Content-Encoding") == "gzip":
                data = gzip.decompress(data)
            js = json.loads(data.decode("utf-8"))
            if js.get("status") == "ok":
                loaded = js.get("loaded_models", [])
                if loaded and isinstance(loaded, list) and len(loaded) > 0:
                    first = loaded[0]
                    name = first.get("name") if isinstance(first, dict) else str(first)
                    if name and name.lower() not in IGNORED_MODELS:
                        return name
                m_loaded = js.get("model_loaded")
                if m_loaded and str(m_loaded).lower() not in IGNORED_MODELS:
                    return str(m_loaded)
    except Exception:
        pass
    return None


def get_best_webui_db_path():
    patterns = [
        os.path.expanduser("~/.local/share/open-webui/webui.db"),
        os.path.expanduser("~/.open-webui/webui.db"),
        os.path.expanduser("~/.cache/uv/archive-v0/*/lib/python3.11/site-packages/open_webui/data/webui.db")
    ]
    for pat in patterns:
        matches = glob.glob(pat)
        if matches:
            matches.sort(key=os.path.getmtime, reverse=True)
            return matches[0]
    return patterns[0]


def fetch_metrics_hermes():
    # Find all Hermes DBs (root + profiles)
    hermes_db_paths = []
    if os.path.exists(HERMES_DB_PATH):
        hermes_db_paths.append(HERMES_DB_PATH)
    profile_pattern = os.path.expanduser("~/.hermes/profiles/*/state.db")
    for path in glob.glob(profile_pattern):
        if os.path.exists(path):
            hermes_db_paths.append(path)

    best_session = None
    best_activity = -1.0

    for db_path in hermes_db_paths:
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            cur = conn.cursor()
            cur.execute("""
                SELECT id, title, model, last_activity_at, started_at, input_tokens, output_tokens, reasoning_tokens, tool_call_count, cwd
                FROM sessions
                WHERE archived = 0 AND hidden = 0
                ORDER BY COALESCE(last_activity_at, started_at) DESC
                LIMIT 1;
            """)
            row = cur.fetchone()
            conn.close()

            if not row:
                continue

            session_id, title, model, last_activity, started_at, in_tok, out_tok, reason_tok, tool_count, cwd = row
            activity_ts = float(last_activity or started_at or time.time())
            
            if activity_ts > best_activity:
                best_activity = activity_ts
                best_session = {
                    "source": "hermes",
                    "source_label": "Hermes Agent",
                    "status": "online",
                    "method": "sqlite",
                    "session_id": session_id,
                    "chat_title": title or "Hermes Task",
                    "directory": cwd or os.path.expanduser("~"),
                    "agent_mode": "agent",
                    "model": clean_model_name(model or "Hermes"),
                    "raw_model": model,
                    "prompt_tokens": in_tok or 0,
                    "completion_tokens": out_tok or 0,
                    "reasoning_tokens": reason_tok or 0,
                    "total_tokens": (in_tok or 0) + (out_tok or 0) + (reason_tok or 0),
                    "tool_calls": tool_count or 0,
                    "tokens_per_sec": 0.0,
                    "prompt_per_sec": 0.0,
                    "updated_at": activity_ts
                }
        except Exception as e:
            print(f"[TokenWatcher] Hermes DB fetch error: {e}", file=sys.stderr)
            continue

    return best_session


def fetch_metrics_openwebui(config):
    db_path = get_best_webui_db_path()
    if not os.path.exists(db_path):
        return None

    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = conn.cursor()
        cur.execute("SELECT id, title, chat, updated_at FROM chat ORDER BY updated_at DESC LIMIT 5;")
        rows = cur.fetchall()
        conn.close()

        if not rows:
            return None

        for row in rows:
            chat_id, title, chat_json_str, updated_at = row
            try:
                chat_data = json.loads(chat_json_str) if chat_json_str else {}
            except Exception:
                chat_data = {}

            history = chat_data.get("history", {})
            messages = history.get("messages", {})

            last_msg = None
            if messages:
                sorted_msgs = sorted(
                    messages.values(),
                    key=lambda m: m.get("timestamp", m.get("created_at", 0)),
                    reverse=True
                )
                if sorted_msgs:
                    last_msg = sorted_msgs[0]

            model = None
            if last_msg:
                model = last_msg.get("selectedModelId") or last_msg.get("model")
            if not model:
                models_list = chat_data.get("models", [])
                if models_list and isinstance(models_list, list):
                    model = models_list[0]

            # Filter out test/dummy model IDs
            if model and str(model).lower() in IGNORED_MODELS:
                continue

            cleaned_model = clean_model_name(model or "Gemma-4-12B")

            total_prompt_tokens = 0
            total_completion_tokens = 0
            latest_eval_count = 0
            latest_eval_duration = 0
            latest_prompt_count = 0
            latest_prompt_duration = 0

            for m in messages.values():
                info = m.get("info", {})
                if not info:
                    continue
                p_tok = info.get("prompt_eval_count", 0) or info.get("prompt_tokens", 0)
                c_tok = info.get("eval_count", 0) or info.get("completion_tokens", 0)
                total_prompt_tokens += p_tok
                total_completion_tokens += c_tok

            if last_msg:
                info = last_msg.get("info", {})
                if info:
                    latest_eval_count = info.get("eval_count", 0) or info.get("completion_tokens", 0)
                    latest_eval_duration = info.get("eval_duration", 0)
                    latest_prompt_count = info.get("prompt_eval_count", 0) or info.get("prompt_tokens", 0)
                    latest_prompt_duration = info.get("prompt_eval_duration", 0)

            tps = 0.0
            if latest_eval_duration > 0:
                tps = round(latest_eval_count / (latest_eval_duration / 1e9), 1)
            elif latest_eval_count > 0:
                tps = 15.0

            pps = 0.0
            if latest_prompt_duration > 0:
                pps = round(latest_prompt_count / (latest_prompt_duration / 1e9), 1)

            total_tokens = total_prompt_tokens + total_completion_tokens
            if total_tokens == 0 and messages:
                total_tokens = len(messages) * 120

            up_sec = float(updated_at or time.time())

            return {
                "source": "openwebui",
                "source_label": "OpenWebUI",
                "status": "online",
                "method": "sqlite",
                "chat_title": title or "Chat Session",
                "model": cleaned_model,
                "raw_model": model or "Gemma-4-12B-it-GGUF",
                "prompt_tokens": total_prompt_tokens,
                "completion_tokens": total_completion_tokens,
                "reasoning_tokens": 0,
                "total_tokens": total_tokens,
                "tokens_per_sec": tps,
                "prompt_per_sec": pps,
                "updated_at": up_sec
            }

    except Exception as e:
        print(f"[TokenWatcher] OpenWebUI SQLite fetch error: {e}", file=sys.stderr)

    return None


def fetch_metrics_opencode():
    if not os.path.exists(OPENCODE_DB_PATH):
        return None

    try:
        conn = sqlite3.connect(f"file:{OPENCODE_DB_PATH}?mode=ro", uri=True)
        cur = conn.cursor()
        
        cur.execute("SELECT id, title, directory, model, time_updated FROM session ORDER BY time_updated DESC LIMIT 1;")
        sess = cur.fetchone()
        if not sess:
            conn.close()
            return None

        sess_id, title, directory, model_json, time_updated = sess
        model_name = "Qwen3-Coder-30B-A3B-Instruct-GGUF"
        if model_json:
            try:
                mdata = json.loads(model_json)
                model_name = mdata.get("id") or mdata.get("model") or model_name
            except Exception:
                pass

        cur.execute("""
            SELECT data, time_updated 
            FROM part 
            WHERE session_id = ? AND data LIKE '%tokens%'
            ORDER BY time_updated DESC LIMIT 1;
        """, (sess_id,))
        prow = cur.fetchone()
        
        prompt_tokens = 0
        completion_tokens = 0
        reasoning_tokens = 0
        total_tokens = 0
        tps = 0.0

        if prow and prow[0]:
            try:
                pdata = json.loads(prow[0])
                toks = pdata.get("tokens", {})
                cache_obj = toks.get("cache", {}) if isinstance(toks.get("cache"), dict) else {}
                cache_tokens = (cache_obj.get("read", 0) or 0) + (cache_obj.get("write", 0) or 0)
                prompt_tokens = (toks.get("input", 0) or 0) + cache_tokens
                completion_tokens = toks.get("output", 0) or 0
                reasoning_tokens = toks.get("reasoning", 0) or 0
                total_tokens = toks.get("total", prompt_tokens + completion_tokens + reasoning_tokens)
            except Exception:
                pass
        else:
            cur.execute("""
                SELECT data, time_updated 
                FROM part 
                WHERE data LIKE '%tokens%'
                ORDER BY time_updated DESC LIMIT 1;
            """)
            fallback_row = cur.fetchone()
            if fallback_row and fallback_row[0]:
                try:
                    pdata = json.loads(fallback_row[0])
                    toks = pdata.get("tokens", {})
                    cache_obj = toks.get("cache", {}) if isinstance(toks.get("cache"), dict) else {}
                    cache_tokens = (cache_obj.get("read", 0) or 0) + (cache_obj.get("write", 0) or 0)
                    prompt_tokens = (toks.get("input", 0) or 0) + cache_tokens
                    completion_tokens = toks.get("output", 0) or 0
                    reasoning_tokens = toks.get("reasoning", 0) or 0
                    total_tokens = toks.get("total", prompt_tokens + completion_tokens + reasoning_tokens)
                except Exception:
                    pass

        conn.close()

        up_sec = (time_updated / 1000.0) if (time_updated and time_updated > 1e11) else (time_updated or time.time())

        return {
            "source": "opencode",
            "source_label": "OpenCode",
            "status": "online",
            "method": "sqlite",
            "chat_title": title or (os.path.basename(directory) if directory else "Coding Session"),
            "directory": directory or os.path.expanduser("~"),
            "agent_mode": "build",
            "model": clean_model_name(model_name),
            "raw_model": model_name,
            "prompt_tokens": prompt_tokens,
            "completion_tokens": completion_tokens,
            "reasoning_tokens": reasoning_tokens,
            "total_tokens": total_tokens,
            "tokens_per_sec": tps,
            "prompt_per_sec": 0.0,
            "updated_at": up_sec
        }
    except Exception as e:
        print(f"[TokenWatcher] OpenCode fetch error: {e}", file=sys.stderr)
    return None


def _resolve_temp_input_in_hwmon(hwmon_dir: Path, target_label: str):
    """Resolve the Path to temp*_input matching target_label (or fallback to temp1_input)."""
    try:
        for label_file in sorted(hwmon_dir.glob("temp*_label")):
            try:
                label_val = label_file.read_text(encoding="utf-8").strip().lower()
            except OSError:
                continue
            if label_val == target_label.lower():
                candidate = hwmon_dir / label_file.name.replace("_label", "_input")
                if candidate.is_file():
                    return candidate.resolve()
        fallback = hwmon_dir / "temp1_input"
        if fallback.is_file():
            return fallback.resolve()
    except OSError:
        pass
    return None


def discover_hardware_sensors():
    """Dynamically discover and cache Path objects for AMD DRM & hwmon sensors."""
    _SENSOR_CACHE.update({
        "initialized": True,
        "drm_device_dir": None,
        "vram_used": None,
        "vram_total": None,
        "gpu_busy": None,
        "gpu_temp_edge": None,
        "gpu_power": None,
        "gpu_clock": None,
        "cpu_temp_tctl": None,
    })

    drm_root = TELEMETRY_CONFIG["drm_sysfs_root"]
    best_dev_dir = None

    try:
        if drm_root.is_dir():
            for entry in sorted(drm_root.iterdir()):
                if not entry.name.startswith("card") or "-" in entry.name:
                    continue
                dev_dir = entry / "device"
                vendor_file = dev_dir / "vendor"
                if not vendor_file.is_file():
                    continue
                try:
                    vendor_str = vendor_file.read_text(encoding="utf-8").strip().lower()
                except OSError:
                    continue
                if TELEMETRY_CONFIG["amd_vendor_id"] not in vendor_str:
                    continue
                has_busy = (dev_dir / "gpu_busy_percent").is_file()
                has_vram = (dev_dir / "mem_info_vram_used").is_file()
                if has_busy or has_vram:
                    best_dev_dir = dev_dir.resolve()
                    break
                if best_dev_dir is None:
                    best_dev_dir = dev_dir.resolve()
    except OSError:
        pass

    if best_dev_dir is not None:
        _SENSOR_CACHE["drm_device_dir"] = best_dev_dir
        for key, filename in (
            ("vram_used", "mem_info_vram_used"),
            ("vram_total", "mem_info_vram_total"),
            ("gpu_busy", "gpu_busy_percent"),
        ):
            p = best_dev_dir / filename
            if p.is_file():
                _SENSOR_CACHE[key] = p

        hwmon_parent = best_dev_dir / "hwmon"
        try:
            if hwmon_parent.is_dir():
                for hw_dir in sorted(hwmon_parent.iterdir()):
                    if not hw_dir.is_dir():
                        continue
                    edge_path = _resolve_temp_input_in_hwmon(hw_dir, TELEMETRY_CONFIG["edge_label"])
                    if edge_path is not None:
                        _SENSOR_CACHE["gpu_temp_edge"] = edge_path
                    p_avg = hw_dir / "power1_average"
                    p_in = hw_dir / "power1_input"
                    if p_avg.is_file():
                        _SENSOR_CACHE["gpu_power"] = p_avg.resolve()
                    elif p_in.is_file():
                        _SENSOR_CACHE["gpu_power"] = p_in.resolve()
                    f_in = hw_dir / "freq1_input"
                    if f_in.is_file():
                        _SENSOR_CACHE["gpu_clock"] = f_in.resolve()
                    break
        except OSError:
            pass

    hwmon_root = TELEMETRY_CONFIG["hwmon_sysfs_root"]
    try:
        if hwmon_root.is_dir():
            for hw_dir in sorted(hwmon_root.iterdir()):
                name_file = hw_dir / "name"
                if not name_file.is_file():
                    continue
                try:
                    hw_name = name_file.read_text(encoding="utf-8").strip().lower()
                except OSError:
                    continue
                if hw_name in TELEMETRY_CONFIG["apu_hwmon_names"]:
                    tctl_path = _resolve_temp_input_in_hwmon(hw_dir, TELEMETRY_CONFIG["tctl_label"])
                    if tctl_path is not None:
                        _SENSOR_CACHE["cpu_temp_tctl"] = tctl_path
                        break
    except OSError:
        pass


def _sanitize_temp_c(val_float):
    """Sanitize temperature in Celsius within physical bounds [5, 125]."""
    try:
        temp_c = int(round(float(val_float)))
        if TELEMETRY_CONFIG["temp_min_c"] <= temp_c <= TELEMETRY_CONFIG["temp_max_c"]:
            return temp_c
    except (ValueError, TypeError):
        pass
    return None


def _compute_temp_status(temp_c):
    """Return 'normal', 'warm', 'critical', or None."""
    if temp_c is None:
        return None
    if temp_c < TELEMETRY_CONFIG["temp_warm_c"]:
        return "normal"
    if temp_c < TELEMETRY_CONFIG["temp_critical_c"]:
        return "warm"
    return "critical"


def _read_cached_sysfs_once():
    """Read all cached sysfs sensor paths. Raises OSError if a cached file disappears."""
    out = {
        "vram_used_gb": 0.0,
        "vram_total_gb": 0.0,
        "gpu_busy_percent": 0,
        "edge_temp_c": None,
        "cpu_temp_tctl_c": None,
        "gpu_power_w": None,
        "gpu_clock_mhz": None,
    }

    if _SENSOR_CACHE["vram_used"] is not None:
        raw = _SENSOR_CACHE["vram_used"].read_text(encoding="utf-8").strip()
        out["vram_used_gb"] = round(int(raw) / (1024**3), 2)

    if _SENSOR_CACHE["vram_total"] is not None:
        raw = _SENSOR_CACHE["vram_total"].read_text(encoding="utf-8").strip()
        out["vram_total_gb"] = round(int(raw) / (1024**3), 2)

    if _SENSOR_CACHE["gpu_busy"] is not None:
        raw = _SENSOR_CACHE["gpu_busy"].read_text(encoding="utf-8").strip()
        out["gpu_busy_percent"] = int(raw)

    if _SENSOR_CACHE["gpu_temp_edge"] is not None:
        raw = _SENSOR_CACHE["gpu_temp_edge"].read_text(encoding="utf-8").strip()
        out["edge_temp_c"] = _sanitize_temp_c(int(raw) / TELEMETRY_CONFIG["milli_divisor"])

    if _SENSOR_CACHE["gpu_power"] is not None:
        try:
            raw = _SENSOR_CACHE["gpu_power"].read_text(encoding="utf-8").strip()
            out["gpu_power_w"] = int(round(int(raw) / TELEMETRY_CONFIG["micro_divisor"]))
        except (OSError, ValueError):
            out["gpu_power_w"] = None

    if _SENSOR_CACHE["gpu_clock"] is not None:
        try:
            raw = _SENSOR_CACHE["gpu_clock"].read_text(encoding="utf-8").strip()
            out["gpu_clock_mhz"] = int(round(int(raw) / TELEMETRY_CONFIG["micro_divisor"]))
        except (OSError, ValueError):
            out["gpu_clock_mhz"] = None

    if _SENSOR_CACHE["cpu_temp_tctl"] is not None:
        raw = _SENSOR_CACHE["cpu_temp_tctl"].read_text(encoding="utf-8").strip()
        out["cpu_temp_tctl_c"] = _sanitize_temp_c(int(raw) / TELEMETRY_CONFIG["milli_divisor"])

    return out


def _fallback_sensors_cli():
    """Level 2 Fallback: sensors -j (shell=False, timeout=2.0)."""
    edge_c = None
    tctl_c = None
    sensors_bin = shutil.which("sensors")
    if not sensors_bin:
        return edge_c, tctl_c
    try:
        res = subprocess.run(
            [sensors_bin, "-j"],
            shell=False,
            capture_output=True,
            text=True,
            timeout=TELEMETRY_CONFIG["cli_timeout_s"],
        )
        if res.returncode == 0 and res.stdout:
            data = json.loads(res.stdout)
            for chip, entries in data.items():
                if not isinstance(entries, dict):
                    continue
                chip_lower = chip.lower()
                if "amdgpu" in chip_lower and edge_c is None:
                    for key, val in entries.items():
                        if isinstance(val, dict) and key.lower() == TELEMETRY_CONFIG["edge_label"]:
                            for sub_k, sub_v in val.items():
                                if sub_k.endswith("_input") and isinstance(sub_v, (int, float)):
                                    edge_c = _sanitize_temp_c(sub_v)
                                    break
                if any(k in chip_lower for k in TELEMETRY_CONFIG["apu_hwmon_names"]) and tctl_c is None:
                    for key, val in entries.items():
                        if isinstance(val, dict) and key.lower() == TELEMETRY_CONFIG["tctl_label"]:
                            for sub_k, sub_v in val.items():
                                if sub_k.endswith("_input") and isinstance(sub_v, (int, float)):
                                    tctl_c = _sanitize_temp_c(sub_v)
                                    break
    except (OSError, ValueError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return edge_c, tctl_c


def _fallback_amdgpu_top_cli():
    """Level 3 Fallback: amdgpu_top --dump -J (shell=False, timeout=2.0)."""
    amdgpu_top_bin = shutil.which("amdgpu_top")
    if not amdgpu_top_bin:
        return None
    try:
        res = subprocess.run(
            [amdgpu_top_bin, "--dump", "-J"],
            shell=False,
            capture_output=True,
            text=True,
            timeout=TELEMETRY_CONFIG["cli_timeout_s"],
        )
        if res.returncode == 0 and res.stdout:
            parsed = json.loads(res.stdout)
            devices = parsed.get("devices", [parsed]) if isinstance(parsed, dict) else (parsed if isinstance(parsed, list) else [])
            for dev in devices:
                if not isinstance(dev, dict):
                    continue
                sensors = dev.get("Sensors", {})
                if isinstance(sensors, dict):
                    edge_obj = sensors.get("Edge Temperature")
                    if isinstance(edge_obj, dict) and "value" in edge_obj:
                        c = _sanitize_temp_c(edge_obj["value"])
                        if c is not None:
                            return c
                    elif isinstance(edge_obj, (int, float)):
                        c = _sanitize_temp_c(edge_obj)
                        if c is not None:
                            return c
    except (OSError, ValueError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return None


def get_gpu_metrics():
    """Get GPU & APU telemetry using cached sysfs paths and multi-level CLI fallbacks."""
    if not _SENSOR_CACHE["initialized"]:
        discover_hardware_sensors()

    try:
        raw_metrics = _read_cached_sysfs_once()
    except (FileNotFoundError, OSError, ValueError):
        # Re-discover once on cache miss / stale sysfs node
        discover_hardware_sensors()
        try:
            raw_metrics = _read_cached_sysfs_once()
        except (FileNotFoundError, OSError, ValueError):
            raw_metrics = {
                "vram_used_gb": 0.0,
                "vram_total_gb": 0.0,
                "gpu_busy_percent": 0,
                "edge_temp_c": None,
                "cpu_temp_tctl_c": None,
                "gpu_power_w": None,
                "gpu_clock_mhz": None,
            }

    edge_c = raw_metrics["edge_temp_c"]
    tctl_c = raw_metrics["cpu_temp_tctl_c"]

    # Level 2 Fallback: sensors -j
    if edge_c is None or tctl_c is None:
        fb_edge, fb_tctl = _fallback_sensors_cli()
        if edge_c is None and fb_edge is not None:
            edge_c = fb_edge
        if tctl_c is None and fb_tctl is not None:
            tctl_c = fb_tctl

    # Level 3 Fallback: amdgpu_top --dump -J
    if edge_c is None:
        edge_c = _fallback_amdgpu_top_cli()

    # Primary GPU temperature uses Edge, or falls back to APU Tctl if Edge is unavailable (Lot 1.1)
    gpu_temp_c = edge_c if edge_c is not None else tctl_c
    gpu_temp_status = _compute_temp_status(gpu_temp_c)

    return {
        "vram_used_gb": raw_metrics["vram_used_gb"],
        "vram_total_gb": raw_metrics["vram_total_gb"],
        "gpu_busy_percent": raw_metrics["gpu_busy_percent"],
        "temp_c": gpu_temp_c if gpu_temp_c is not None else 0,
        "gpu_temp_c": gpu_temp_c,
        "cpu_temp_tctl_c": tctl_c,
        "gpu_power_w": raw_metrics["gpu_power_w"],
        "gpu_clock_mhz": raw_metrics["gpu_clock_mhz"],
        "gpu_temp_status": gpu_temp_status,
    }


def write_state(state):
    tmp_path = STATE_PATH + ".tmp"
    try:
        with open(tmp_path, "w") as f:
            json.dump(state, f, indent=2)
        os.replace(tmp_path, STATE_PATH)
    except Exception as e:
        print(f"[TokenWatcher] Error writing state: {e}", file=sys.stderr)


def main():
    config = load_config()
    discover_hardware_sensors()
    print("[TokenWatcher] Multi-Source Daemon started (Hermes + OpenCode + OpenWebUI + Lemonade)", file=sys.stderr)

    while True:
        try:
            lemonade_loaded = get_lemonade_loaded_model(config.get("lemonade_url", "http://127.0.0.1:13305"))
            
            hermes_metrics = fetch_metrics_hermes()
            opencode_metrics = fetch_metrics_opencode()
            openwebui_metrics = fetch_metrics_openwebui(config)
            gpu_metrics = get_gpu_metrics()

            # Determine most recently active source
            candidates = []
            if hermes_metrics and hermes_metrics.get("updated_at"):
                candidates.append(("hermes", hermes_metrics["updated_at"], hermes_metrics))
            if opencode_metrics and opencode_metrics.get("updated_at"):
                candidates.append(("opencode", opencode_metrics["updated_at"], opencode_metrics))
            if openwebui_metrics and openwebui_metrics.get("updated_at"):
                candidates.append(("openwebui", openwebui_metrics["updated_at"], openwebui_metrics))

            active_source = ""
            active_chat = None

            if candidates:
                candidates.sort(key=lambda x: x[1], reverse=True)
                active_source = candidates[0][0]
                active_chat = candidates[0][2]

            # If Lemonade is running a local model, attach it
            if active_chat and lemonade_loaded and active_source in ["opencode", "lemonade"]:
                active_chat["model"] = lemonade_loaded

            # Choose symbolic icon
            if active_source == "openwebui":
                icon_name = "chat-message-new-symbolic"
            else:
                icon_name = "utilities-terminal-symbolic"

            state = {
                "version": "2.0",
                "timestamp": time.time(),
                "source": active_source,
                "icon": icon_name,
                "chat": active_chat,
                "sources": {
                    "hermes": hermes_metrics,
                    "opencode": opencode_metrics,
                    "openwebui": openwebui_metrics
                },
                "lemonade_loaded_model": lemonade_loaded,
                "gpu": gpu_metrics,
                "gpu_temp_c": gpu_metrics.get("gpu_temp_c"),
                "cpu_temp_tctl_c": gpu_metrics.get("cpu_temp_tctl_c"),
                "gpu_power_w": gpu_metrics.get("gpu_power_w"),
                "gpu_clock_mhz": gpu_metrics.get("gpu_clock_mhz"),
                "gpu_temp_status": gpu_metrics.get("gpu_temp_status"),
            }

            write_state(state)

        except Exception as e:
            print(f"[TokenWatcher] Loop error: {e}", file=sys.stderr)

        time.sleep(config.get("poll_interval", 1.0))


if __name__ == "__main__":
    main()
